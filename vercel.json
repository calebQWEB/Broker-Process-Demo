{
    "rewrites": [
        { "source": "/api/:path*", "destination": "/api/router?path=:path*" },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ],
    "functions": {
        "api/router.js": { "maxDuration": 60 }
    },
    "crons": [
        { "path": "/api/cron/keep-alive", "schedule": "0 9 */3 * *" }
    ]
}
